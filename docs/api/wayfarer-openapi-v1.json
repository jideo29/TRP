{
  "openapi": "3.0.4",
  "info": {
    "title": "Wayfarer",
    "description": "Fail-closed remittance host. Live payout is not implemented and the payout operation does not move money. The payout operation requires an Aegis Bearer access token (validated signature, issuer, audience, algorithm, lifetime and revocation); the tenant comes from the token. /api/host and /health do not require a token.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/host": {
      "get": {
        "tags": [
          "Host"
        ],
        "summary": "Returns the identity of this fail-closed remittance host.",
        "description": "Reads the published identity of this process. It does not enable payout.",
        "operationId": "GetHostIdentity",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostIdentity"
                }
              }
            }
          }
        }
      }
    },
    "/api/remittance/payout": {
      "post": {
        "tags": [
          "Remittance"
        ],
        "summary": "Payout toward Pulse. No settlement is claimed.",
        "description": "Requires an Aegis Bearer access token. The tenant comes from the token; a customerRef.tenantId that differs is refused with 403. Live payout is not implemented. customerRef is required. The handoff is POST /corp-pay/orchestrate, the Pulse path Summit uses, with channelProduct instapay or pesonet and no default rail. It does not post to Titan. Integrated mode fails closed when Pulse, Atlas, or Sentinel is unset. The standalone stand-in is labeled SIMULATED. This operation does not claim settlement, bank_booked, or money_pass.",
        "operationId": "RefusePayout",
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoutRefusal"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Process probe. Live payout is not available.",
        "description": "Reports that the process is up. It does not report a live payout path.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostHealth"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HostHealth": {
        "required": [
          "status",
          "moneyPass",
          "remittanceJourneyUnblocked",
          "livePayout"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "moneyPass": {
            "type": "boolean"
          },
          "remittanceJourneyUnblocked": {
            "type": "boolean"
          },
          "livePayout": {
            "type": "boolean"
          }
        }
      },
      "HostIdentity": {
        "required": [
          "product",
          "repository",
          "role",
          "notPulse",
          "tension",
          "statement",
          "livePayout",
          "moneyPass",
          "remittanceJourneyUnblocked",
          "journeyAcceptClaimed",
          "novaRemittanceIntentsAbsorbedByPulse",
          "equicom",
          "outboundEmail",
          "sellOpen"
        ],
        "type": "object",
        "properties": {
          "product": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "notPulse": {
            "type": "boolean"
          },
          "tension": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "livePayout": {
            "type": "boolean"
          },
          "moneyPass": {
            "type": "boolean"
          },
          "remittanceJourneyUnblocked": {
            "type": "boolean"
          },
          "journeyAcceptClaimed": {
            "type": "boolean"
          },
          "novaRemittanceIntentsAbsorbedByPulse": {
            "type": "boolean"
          },
          "equicom": {
            "type": "string"
          },
          "outboundEmail": {
            "type": "boolean"
          },
          "sellOpen": {
            "type": "string"
          }
        }
      },
      "PayoutRefusal": {
        "required": [
          "statusCode",
          "code",
          "message",
          "payoutExecuted",
          "moneyPass",
          "label",
          "bankBooked",
          "settlementClaimed"
        ],
        "type": "object",
        "properties": {
          "statusCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "payoutExecuted": {
            "type": "boolean"
          },
          "moneyPass": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "bankBooked": {
            "type": "boolean"
          },
          "settlementClaimed": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "HTTP Bearer authentication with a JWT access token.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Host"
    },
    {
      "name": "Remittance"
    },
    {
      "name": "Health"
    }
  ]
}
